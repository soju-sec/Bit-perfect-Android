<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. Ambient outer glass boundary shadow -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#33000000" />
            <corners android:radius="32dp" />
        </shape>
    </item>

    <!-- 2. Frosted Translucent Smoked Glass Body with Specular Border -->
    <item
        android:top="1dp"
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp">
        <shape android:shape="rectangle">
            <!-- Semi-translucent dark smoked glass gradient (allows background to softly bleed through) -->
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#D6232733"
                android:centerColor="#B81A1C24"
                android:endColor="#9E13141A" />
            <corners android:radius="31dp" />
            <!-- Specular frosted glass rim -->
            <stroke
                android:width="1.2dp"
                android:color="#4DFFFFFF" />
        </shape>
    </item>

    <!-- 3. Top Rim Specular Highlight (Optical Glass Refraction Flare) -->
    <item
        android:top="2dp"
        android:left="24dp"
        android:right="24dp"
        android:height="1.2dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#00FFFFFF"
                android:centerColor="#70FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>

    <!-- 4. Subtle Bottom Inner Glow -->
    <item
        android:bottom="2dp"
        android:left="36dp"
        android:right="36dp"
        android:height="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#00FFFFFF"
                android:centerColor="#26FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
