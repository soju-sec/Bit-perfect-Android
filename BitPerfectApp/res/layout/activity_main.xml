<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:fitsSystemWindows="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="120dp">

            <!-- ================= PAGE 1: DASHBOARD ================= -->
            <LinearLayout
                android:id="@+id/pageDashboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Top Bar: Clean Minimalist Header (Without Bell/Calendar) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dashboard"
                        android:textColor="@color/text_title"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pemantauan Audio Bit-Perfect Live"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- Hero Center Card: Segmented Arch Gauge & Big Live Stat (White Card) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_white"
                    android:orientation="vertical"
                    android:paddingTop="16dp"
                    android:paddingBottom="20dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:gravity="center_horizontal"
                    android:elevation="2dp"
                    android:layout_marginBottom="14dp">

                    <!-- Audio Pipeline Live Arch Meter -->
                    <dev.deco.bitperfect.AudioPipelineGaugeView
                        android:id="@+id/pipelineGaugeView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!-- Pill button under Arch (Matching '+' pill in Mockup) -->
                    <TextView
                        android:id="@+id/btnToggleAutoSync"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:text="+  Ikuti Rate Otomatis: AKTIF"
                        android:textColor="@color/text_title"
                        android:background="@drawable/bg_pill_button"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginTop="6dp" />

                </LinearLayout>

                <!-- Card 1: Stream Sumber (Like Lunch card in Mockup) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_white"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:elevation="2dp"
                    android:layout_marginBottom="12dp">

                    <RelativeLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_squircle_coral">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="🎵"
                            android:textSize="20sp" />
                    </RelativeLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvActiveApp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tidak Ada Pemutaran"
                            android:textColor="@color/text_title"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSourceDetail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Audio Idle"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvSourceRate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-- kHz"
                            android:textColor="@color/text_title"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSourceBitDepth"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textColor="@color/accent_coral"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Card 2: Hardware DAC (Like Breakfast card in Mockup) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_white"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:elevation="2dp"
                    android:layout_marginBottom="14dp">

                    <RelativeLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_squircle_coral">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="🎧"
                            android:textSize="20sp" />
                    </RelativeLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDacName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tidak Ada DAC USB"
                            android:textColor="@color/text_title"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDacFormat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Status: Terputus (Unplugged)"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDacRate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-- kHz"
                            android:textColor="@color/text_muted"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvMatchBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Offline"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>


            <!-- ================= PAGE 2: TARGET APPS (BYPASS) ================= -->
            <LinearLayout
                android:id="@+id/pageApps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:id="@+id/tvAppsTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Target Bypass"
                        android:textColor="@color/text_title"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAppsCountBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/tvAppsTitle"
                        android:layout_alignBaseline="@id/tvAppsTitle"
                        android:layout_marginStart="8dp"
                        android:text="0 Terdeteksi"
                        android:textColor="@color/accent_coral"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aplikasi audio yang diizinkan mem-bypass mixer Android langsung ke DAC"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp" />

                <!-- Action Bar: Select All / Deselect All -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:id="@+id/btnSelectAllApps"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="✓  Pilih Semua"
                        android:textColor="@color/accent_coral"
                        android:background="@drawable/bg_pill_button"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/btnDeselectAllApps"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="✕  Nonaktifkan Semua"
                        android:textColor="@color/text_muted"
                        android:background="@drawable/bg_pill_button"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- Dynamic Apps Container -->
                <LinearLayout
                    android:id="@+id/containerInstalledApps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Empty state if scanning or none -->
                <TextView
                    android:id="@+id/tvEmptyApps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_white"
                    android:padding="24dp"
                    android:gravity="center"
                    android:text="Memindai aplikasi pemutar audio di sistem..."
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"
                    android:visibility="gone"
                    android:layout_marginBottom="14dp" />

                <!-- Video Apps Safe Rule Banner -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_white"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:elevation="2dp"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🛡️ PERLINDUNGAN SINKRONISASI VIDEO"
                        android:textColor="@color/accent_coral"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Aplikasi video (YouTube, TikTok, Netflix) secara otomatis dilindungi di mixer standar 48 kHz agar video tidak mengalami delay/patah-patah saat berganti frame."
                        android:textColor="@color/text_body"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp" />
                </LinearLayout>

            </LinearLayout>


            <!-- ================= PAGE 3: MANUAL RATE & BIT CONTROLLER ================= -->
            <LinearLayout
                android:id="@+id/pageRate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Clock &amp; Format Controller"
                    android:textColor="@color/text_title"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kunci resolusi bit depth dan sample rate hardware DAC"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp" />

                <!-- Bit Depth Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_white"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:elevation="2dp"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="KEDALAMAN BIT (BIT DEPTH)"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Format kuantisasi sample PCM yang dikirim ke hardware DAC"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:layout_marginBottom="12dp" />

                    <!-- 4 Bit Depth Buttons: Auto (1:1), 16-bit, 24-bit, 32-bit -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnBitAuto"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:text="Auto (1:1)"
                            android:textColor="@color/card_bg"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:background="@drawable/btn_rate_light_active"
                            android:textAllCaps="false"
                            android:layout_marginEnd="6dp" />

                        <Button
                            android:id="@+id/btnBit16"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:text="16-bit"
                            android:textColor="@color/text_title"
                            android:textSize="12sp"
                            android:background="@drawable/btn_rate_light"
                            android:textAllCaps="false"
                            android:layout_marginEnd="6dp" />

                        <Button
                            android:id="@+id/btnBit24"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:text="24-bit"
                            android:textColor="@color/text_title"
                            android:textSize="12sp"
                            android:background="@drawable/btn_rate_light"
                            android:textAllCaps="false"
                            android:layout_marginEnd="6dp" />

                        <Button
                            android:id="@+id/btnBit32"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:text="32-bit"
                            android:textColor="@color/text_title"
                            android:textSize="12sp"
                            android:background="@drawable/btn_rate_light"
                            android:textAllCaps="false" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Sample Rate 2x4 Grid Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_white"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:elevation="2dp"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FREKUENSI SAMPLE (SAMPLE RATE)"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Kunci clock hardware DAC ke frekuensi tertentu"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:layout_marginBottom="12dp" />

                    <!-- Row 1: 44.1k, 48k, 88.2k, 96k -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="10dp">

                        <Button
                            android:id="@+id/btnRate44k"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:text="44.1k"
                            android:textColor="@color/text_title"
                            android:textSize="12sp"
                            android:background="@drawable/btn_rate_light"
                            android:textAllCaps="false"
                            android:layout_marginEnd="6dp" />

                        <Button
                            android:id="@+id/btnRate48k"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:text="48k"
                            android:textColor="@color/text_title"
                            android:textSize="12sp"
                            android:background="@drawable/btn_rate_light"
                            android:textAllCaps="false"
                            android:layout_marginEnd="6dp" />

                        <Button
                            android:id="@+id/btnRate88k"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:text="88.2k"
                            android:textColor="@color/text_title"
                            android:textSize="12sp"
                            android:background="@drawable/btn_rate_light"
                            android:textAllCaps="false"
                            android:layout_marginEnd="6dp" />

                        <Button
                            android:id="@+id/btnRate96k"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:text="96k"
                            android:textColor="@color/text_title"
                            android:textSize="12sp"
                            android:background="@drawable/btn_rate_light"
                            android:textAllCaps="false" />
                    </LinearLayout>

                    <!-- Row 2: 176.4k, 192k, 384k, Reset -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnRate176k"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:text="176.4k"
                            android:textColor="@color/text_title"
                            android:textSize="12sp"
                            android:background="@drawable/btn_rate_light"
                            android:textAllCaps="false"
                            android:layout_marginEnd="6dp" />

                        <Button
                            android:id="@+id/btnRate192k"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:text="192k"
                            android:textColor="@color/text_title"
                            android:textSize="12sp"
                            android:background="@drawable/btn_rate_light"
                            android:textAllCaps="false"
                            android:layout_marginEnd="6dp" />

                        <Button
                            android:id="@+id/btnRate384k"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:text="384k"
                            android:textColor="@color/text_title"
                            android:textSize="12sp"
                            android:background="@drawable/btn_rate_light"
                            android:textAllCaps="false"
                            android:layout_marginEnd="6dp" />

                        <Button
                            android:id="@+id/btnRateReset"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:text="Reset"
                            android:textColor="@color/accent_coral"
                            android:textSize="12sp"
                            android:background="@drawable/btn_rate_light"
                            android:textAllCaps="false" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>


            <!-- ================= PAGE 4: SETTINGS & SYSTEM ================= -->
            <LinearLayout
                android:id="@+id/pageSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sistem &amp; Engine"
                    android:textColor="@color/text_title"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Konfigurasi Audio HAL Snapdragon &amp; KernelSU"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp" />

                <!-- Action Card: Apply Engine -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_white"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:elevation="2dp"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ROOT ENGINE BIT-PERFECT (STANDALONE)"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Menerapkan bypass mixer secara mandiri langsung dari aplikasi menggunakan hak akses root. Melindungi Deep Buffer agar video (YouTube/TikTok) tidak patah-patah dan bebas suara 'tuk-tuk'."
                        android:textColor="@color/text_body"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp"
                        android:layout_marginBottom="14dp" />

                    <Button
                        android:id="@+id/btnApplyEngine"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="⚡ Terapkan Engine Root Standalone"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_center_squircle_coral"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textAllCaps="false" />
                </LinearLayout>

                <!-- Action Card: Clean Old Module -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_white"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:elevation="2dp"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PEMBERSIH MODUL KERNELSU/MAGISK"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Menghapus modul 'disable_resample_48k' dari KernelSU dan melepas bind-mount vendor agar audio policy kembali bersih dan normal."
                        android:textColor="@color/text_body"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp"
                        android:layout_marginBottom="14dp" />

                    <Button
                        android:id="@+id/btnPurgeModule"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="🗑️ Bersihkan Sisa Modul Lama"
                        android:textColor="@color/text_title"
                        android:background="@drawable/btn_rate_light"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textAllCaps="false" />
                </LinearLayout>

                <!-- Status Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_white"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:elevation="2dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="STATUS AKSES ROOT"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Akses Superuser (KowSU) aktif. Semua fungsi bypass mixer dan sinkronisasi rate berjalan langsung di dalam aplikasi tanpa bergantung pada modul sistem."
                        android:textColor="@color/text_body"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>


    <!-- ================= FLOATING BOTTOM NAVIGATION DOCK ================= -->
    <!-- (Exact replica of the bottom bar in Mockup Screens 1 & 3) -->
    <LinearLayout
        android:id="@+id/layoutBottomDock"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_floating_dock"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:elevation="8dp">

        <!-- Tab 1: Dashboard (Home) -->
        <LinearLayout
            android:id="@+id/navTabDashboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivNavDashboard"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_apple_dashboard"
                android:tint="@color/dock_icon_active"
                android:contentDescription="Dashboard" />

            <TextView
                android:id="@+id/tvNavDashboard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dashboard"
                android:textColor="@color/dock_icon_active"
                android:textSize="9sp"
                android:textStyle="bold"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <!-- Tab 2: Apps (Bypass Selector) -->
        <LinearLayout
            android:id="@+id/navTabApps"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivNavApps"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_apple_bypass"
                android:tint="@color/dock_icon_inactive"
                android:contentDescription="Bypass" />

            <TextView
                android:id="@+id/tvNavApps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bypass"
                android:textColor="@color/dock_icon_inactive"
                android:textSize="9sp"
                android:textStyle="bold"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <!-- Center Highlighted Squircle: Instant Engine Bypass Action -->
        <RelativeLayout
            android:id="@+id/navCenterAction"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_center_squircle_coral"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp">

            <ImageView
                android:id="@+id/ivNavBolt"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_centerInParent="true"
                android:src="@drawable/ic_apple_bolt"
                android:tint="#FFFFFF"
                android:contentDescription="Bolt Action" />
        </RelativeLayout>

        <!-- Tab 3: Rate Controller -->
        <LinearLayout
            android:id="@+id/navTabRate"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivNavRate"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_apple_rate"
                android:tint="@color/dock_icon_inactive"
                android:contentDescription="Rate" />

            <TextView
                android:id="@+id/tvNavRate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rate"
                android:textColor="@color/dock_icon_inactive"
                android:textSize="9sp"
                android:textStyle="bold"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <!-- Tab 4: Settings & System -->
        <LinearLayout
            android:id="@+id/navTabSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivNavSettings"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_apple_settings"
                android:tint="@color/dock_icon_inactive"
                android:contentDescription="Sistem" />

            <TextView
                android:id="@+id/tvNavSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sistem"
                android:textColor="@color/dock_icon_inactive"
                android:textSize="9sp"
                android:textStyle="bold"
                android:layout_marginTop="3dp" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
