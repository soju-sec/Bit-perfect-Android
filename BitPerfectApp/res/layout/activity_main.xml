<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:fitsSystemWindows="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="28dp"
            android:paddingBottom="130dp">

            <!-- 1. Top Bar: Minimalist & Clean -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvAppTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BitPerfect Live"
                        android:textColor="@color/text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Live Pipeline &amp; Zero-SRC DAC Engine"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnEngineStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="⚡ BYPASS ENGINE"
                    android:textColor="@color/accent_emerald"
                    android:background="@drawable/chip_app_active"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />
            </RelativeLayout>

            <!-- 2. Hero Center Card: Segmented Arch & Big Live Stat (Like kcal in mockup) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:paddingTop="14dp"
                android:paddingBottom="16dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center_horizontal"
                android:layout_marginBottom="14dp">

                <!-- The Live Audio Pipeline Segmented Arch Gauge -->
                <dev.deco.bitperfect.AudioPipelineGaugeView
                    android:id="@+id/pipelineGaugeView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- Action Pill under Arch (like the '+' button in mockup) -->
                <TextView
                    android:id="@+id/btnToggleAutoSync"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:gravity="center"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="⚡ Auto-Sync Clock: AKTIF"
                    android:textColor="@color/accent_emerald"
                    android:background="@drawable/chip_app_active"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <!-- 3. Telemetry Stream Cards (Styled like Lunch/Breakfast cards in mockup) -->
            
            <!-- Card 1: Stream Sumber (Track Source) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:layout_marginBottom="10dp">

                <!-- Left: 44dp Squircle Icon -->
                <RelativeLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_icon_squircle">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:text="🎵"
                        android:textSize="18sp" />
                </RelativeLayout>

                <!-- Middle: App & Track Info -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvActiveApp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Apple Music"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSourceDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Stream Sumber • Lossless"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- Right: Big Rate Number & Format -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSourceRate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="96.0 kHz"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSourceBitDepth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="24-bit PCM"
                        android:textColor="@color/accent_emerald"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Card 2: Hardware DAC (Endpoint) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <!-- Left: 44dp Squircle Icon -->
                <RelativeLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_icon_squircle">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:text="🎧"
                        android:textSize="18sp" />
                </RelativeLayout>

                <!-- Middle: DAC Name & ALSA Endpoint -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDacName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kiwi Ears AD1"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDacFormat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="USB Audio • S24_3LE"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- Right: Big DAC Clock & Match -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDacRate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="96.0 kHz"
                        android:textColor="@color/accent_emerald"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMatchBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Zero SRC 1:1"
                        android:textColor="@color/accent_emerald"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 4. Target Aplikasi (Category Chips like Screen 3 in mockup) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TARGET APLIKASI BYPASS"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipApple"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Apple Music"
                        android:textColor="@color/accent_emerald"
                        android:background="@drawable/chip_app_active"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/chipTidal"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="TIDAL"
                        android:textColor="@color/accent_emerald"
                        android:background="@drawable/chip_app_active"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/chipBitchord"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Bitchord"
                        android:textColor="@color/accent_emerald"
                        android:background="@drawable/chip_app_active"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/chipSpotify"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Spotify"
                        android:textColor="@color/text_secondary"
                        android:background="@drawable/chip_app_inactive"
                        android:textSize="11sp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🛡️ Video (YouTube/TikTok) otomatis memakai mixer 48k agar tidak patah-patah."
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:layout_marginTop="10dp" />
            </LinearLayout>

            <!-- 5. Manual Clock Controller -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PILIHAN SAMPLE RATE MANUAL"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="10dp" />

                <!-- Row 1: 44.1k, 48k, 88.2k, 96k -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <Button
                        android:id="@+id/btnRate44k"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="44.1k"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:background="@drawable/btn_rate_glass"
                        android:textAllCaps="false"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btnRate48k"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="48k"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:background="@drawable/btn_rate_glass"
                        android:textAllCaps="false"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btnRate88k"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="88.2k"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:background="@drawable/btn_rate_glass"
                        android:textAllCaps="false"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btnRate96k"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="96k"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:background="@drawable/btn_rate_glass"
                        android:textAllCaps="false" />
                </LinearLayout>

                <!-- Row 2: 176.4k, 192k, 384k, Reset -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnRate176k"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="176.4k"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:background="@drawable/btn_rate_glass"
                        android:textAllCaps="false"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btnRate192k"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="192k"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:background="@drawable/btn_rate_glass"
                        android:textAllCaps="false"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btnRate384k"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="384k"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:background="@drawable/btn_rate_glass"
                        android:textAllCaps="false"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btnRateReset"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="Reset"
                        android:textColor="@color/accent_amber"
                        android:textSize="12sp"
                        android:background="@drawable/btn_rate_glass"
                        android:textAllCaps="false" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Bypass HAL AudioFlinger • Non-destructive • Tanpa Modul Zip Magisk"
                android:textColor="@color/text_muted"
                android:textSize="10sp" />

        </LinearLayout>
    </ScrollView>

    <!-- 6. Floating Bottom Navigation Dock (Like the bottom bar in mockup) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_bottom_dock"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <!-- Left Dock Item: Live Monitor -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊"
                android:textSize="16sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Monitor"
                android:textColor="@color/accent_emerald"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Center Highlighted Action Squircle: Bypass Engine Tweak -->
        <RelativeLayout
            android:id="@+id/dockCenterAction"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_center_action_squircle"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="⚡"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Right Dock Item: Video Safe Status -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛡️"
                android:textSize="16sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Safe Video"
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
