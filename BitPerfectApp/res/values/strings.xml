    <!-- Engine Tweak Section -->
    <string name="title_engine">ENGINE BYPASS MIXER</string>
    <string name="desc_engine">Menerapkan tweak audio HAL langsung dari aplikasi: membuka sampling rate murni hingga 384 kHz, mengaktifkan alokasi DSP 24-bit, dan menonaktifkan burst mode untuk mencegah lagu Hi-Res tersendat.</string>
    <string name="btn_apply_engine">Terapkan Konfigurasi Engine</string>
    <string name="switch_auto_rate">Penyelarasan Clock Otomatis</string>
    <string name="desc_auto_rate">Menyesuaikan frekuensi DAC dengan lagu saat aplikasi musik terpilih memutar audio.</string>
    <string name="switch_safe_pause">Jeda Re-Clocking (3.5 Detik)</string>
    <string name="desc_safe_pause">Menjeda pemutaran sebentar saat sample rate berubah agar audio tidak bocor ke speaker HP saat DAC sinkronisasi ulang.</string>
    
    <!-- Per-App Selection Section -->
    <string name="title_per_app">APLIKASI TERPILIH (PER-APP BYPASS)</string>
    <string name="desc_per_app">Pilih aplikasi yang diizinkan mem-bypass mixer. Aplikasi di luar daftar ini (seperti YouTube, TikTok, Netflix) tetap menggunakan mixer standar 48 kHz agar video tidak patah-patah.</string>
    <string name="app_apple_music">Apple Music</string>
    <string name="app_tidal">TIDAL</string>
    <string name="app_bitchord">Bitchord</string>
    <string name="app_spotify">Spotify</string>
    <string name="app_yt_music">YouTube Music</string>
    <string name="app_video_warning">Aplikasi Video: Tetap di mixer 48 kHz untuk menjaga sinkronisasi frame A/V.</string>
    
    <!-- Manual Controller Section -->
    <string name="title_manual_rate">KONTROL MANUAL FREKUENSI DAC</string>
    <string name="desc_manual_rate">Atur frekuensi mixer / hardware DAC secara manual jika diperlukan.</string>
    <string name="rate_reset">Reset (48k)</string>
    
    <!-- Module Management Section -->
    <string name="title_module_manage">STATUS MODUL MAGISK / KSU</string>
    <string name="desc_module_uninstall">Seluruh fungsionalitas modul kini dikontrol langsung oleh aplikasi ini via Root / Audio HAL. Anda dapat mencopot modul Magisk/KSU lama dengan aman tanpa kehilangan fitur bit-perfect.</string>
    <string name="btn_uninstall_module">Nonaktifkan Modul Magisk Sekarang</string>
