# Expose All Hardware Sample Rates to Apple Music, TIDAL & AudioTrack
ro.audio.samplerates=44100,48000,88200,96000,176400,192000,352800,384000
persist.vendor.audio.samplerates=44100,48000,88200,96000,176400,192000,352800,384000
ro.audio.flinger_standbytime_ms=1000

# Direct PCM & USB Audio Optimization
vendor.audio.feature.usb_offload.enable=true
# Disable burst mode to prevent UAC2 micro-underruns / stuttering on external USB DACs
vendor.audio.feature.usb_offload_burst_mode.enable=false
vendor.audio.feature.hifi_audio.enable=true
vendor.audio.usb.super_high_res=true
audio.deep_buffer.media=false
audio.safemedia.bypass=true

# High-Resolution Buffer & Bit-Depth Stability
persist.vendor.audio.format.24bit=true
persist.vendor.audio_hal.dsp_bit_width_enforce_mode=24
af.fast_track_multiplier=2

# AAudio MMAP & Direct
aaudio.mmap_policy=2
aaudio.mmap_exclusive_policy=2
